{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "dpc.ui.app",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Dashboard (step into dpc)",
      "type": "debugpy",
      "request": "launch",
      "module": "dpc.ui.app",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
